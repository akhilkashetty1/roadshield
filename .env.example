# RoadShield — environment variables
# Copy this file to .env.local for local dev, and set the same values
# as Environment Variables in the Vercel project dashboard for production.

# --- Brevo (transactional email) — required for the contact form ---
# Get an API key: Brevo dashboard → Settings → SMTP & API → API Keys → Generate a new API key (v3)
BREVO_API_KEY=

# The "from" address for outgoing emails — must be a verified sender in Brevo
# (Brevo → Senders, Domains & Dedicated IPs → Senders → Add a sender)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=RoadShield Website

# Where contact-form leads are delivered
ADMIN_EMAIL_PRIMARY=
ADMIN_EMAIL_CC=

# --- Google Sheets lead log (optional) ---
# A Google Apps Script Web App URL that appends each lead as a row in a Sheet.
# Leave blank to skip — the contact form works fine without it (email-only).
GOOGLE_SHEET_WEBAPP_URL=
